# ============ 数据库选型 ============
# mysql | sqlite。不填时：配了 MYSQL_HOST 就走 MySQL，否则走 SQLite。
DB_BACKEND=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 注意：本机便携版实例使用 3307
MYSQL_USER=root
MYSQL_PASSWORD=studyroom
MYSQL_DATABASE=campus_study_room
MYSQL_POOL_SIZE=8

# SQLite 模式下的库文件路径（默认 backend/data/study_room.db）
# STUDY_ROOM_DB=backend/data/study_room.db

# ============ 服务 ============
HOST=127.0.0.1
PORT=8000

# ============ 鉴权 ============
# 登录令牌有效期（天），从登录时刻起算
SESSION_TTL_DAYS=7
# 允许的跨域来源，部署时收敛为具体域名（如 http://127.0.0.1:8000）
CORS_ORIGIN=*
# 口令哈希迭代次数，生产保持 200000；仅测试环境可调低
# PBKDF2_ITERATIONS=200000

# ============ 签到时间窗口 ============
# 预约开始前 N 分钟开放签到；超过「开始 + NO_SHOW_GRACE_MINUTES」判失效
CHECKIN_EARLY_MINUTES=30
# 是否强制校验签到窗口（0 = 关闭，方便课堂演示随时签到）
CHECKIN_ENFORCED=1

# ============ 实时推送（SSE） ============
# 心跳间隔（秒），无事件时用注释帧保活
SSE_HEARTBEAT_SECONDS=15
# 最大同时连接数，超过返回 503（每个连接占一个服务线程）
SSE_MAX_CLIENTS=50

# ============ 违规占座预警规则 ============
# 预约开始后超过 N 分钟未签到 → 判定「超时未签到」，预约自动失效
NO_SHOW_GRACE_MINUTES=15
# 预约结束后超过 N 分钟未结束自习 → 判定「超时占用」，预约自动结束
OVERSTAY_GRACE_MINUTES=30
# 违规统计窗口（天）与限制预约的阈值
VIOLATION_WINDOW_DAYS=30
VIOLATION_BLOCK_THRESHOLD=3
# 后台扫描间隔（秒），0 表示关闭后台线程（只能靠手动接口触发）
SWEEPER_INTERVAL=60
